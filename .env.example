# --- Application ---
APP_ENV=development
APP_NAME=ai-hiring-platform
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=hiring
POSTGRES_PASSWORD=hiring_dev_password
POSTGRES_DB=hiring
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hiring:hiring_dev_password@localhost:5432/hiring

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- OpenAI (swap via LLM provider interface) ---
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- Voice (adapters; leave empty until Milestone voice work) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
